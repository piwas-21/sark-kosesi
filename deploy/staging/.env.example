# Copy outside the repository into a private file (0600). No live provider keys.
STAGING_HOST=sark-kosesi-test.piwas.nl
STAGING_REVISION=replace_with_the_reviewed_40_character_commit
STAGING_DATABASE_PASSWORD=replace_with_an_independent_random_url_safe_secret
STAGING_PREVIEW_TOKEN=replace_with_an_independent_random_url_safe_secret
# Public storefront reads only; privileged/unknown routes still require Basic auth.
STAGING_PUBLIC_STOREFRONT=false
# Username test-admin; use a separate random secret when public storefront is true.
STAGING_ADMIN_TOKEN=replace_with_a_separate_random_url_safe_secret
# Enable ingress only after exact-source review/CI, isolated startup and TLS checks.
STAGING_INGRESS_ENABLED=false
# Choose a distinct unused loopback port when starting alongside another preview.
STAGING_WEB_LOOPBACK_PORT=45972

# Optional callback-edge overlay/profile only. Base Compose does not use these.
# Inspect the actual proxy's exact private addresses; never guess a subnet/gateway.
# CALLBACK_EDGE_PROXY_IPS=replace_with_one_to_four_inspected_exact_proxy_addresses
# CALLBACK_INTAKE_PROFILE_ID=pfl_replace_with_dedicated_test_profile
# Public callback routing stays off until the separate runtime/pilot gates pass.
STAGING_CALLBACK_INGRESS_ENABLED=false
