# Local/test use loopback origins. See deploy/staging/ for private HTTPS staging.
# Production is disabled in every mode.
APP_ENV=local
DATABASE_URL=postgresql://p1_test@127.0.0.1:5432/isolated_preview
API_BIND=127.0.0.1:45671
API_URL=http://127.0.0.1:45671
CANONICAL_ORIGIN=http://127.0.0.1:45672
# Generate 32-128 URL-safe characters locally; never commit a real token.
PREVIEW_TOKEN=replace_with_a_locally_generated_preview_token
# Optional native isolated PostgreSQL binaries; otherwise use pinned Docker image.
P1_POSTGRES_BIN=
# Used only with the explicit --expire-holds command; 1-100 holds per pass.
HOLD_EXPIRY_BATCH=25
# Explicit --reconcile-payments only, local/test. No credential is installed by default.
# The command performs bounded authenticated GETs, never a create/replacement POST.
PAYMENT_RECONCILIATION_BATCH=10
CALLBACK_RECONCILIATION_BATCH=10
# Explicit --reconcile-reversal-pages only; 1-25 steps per pass.
REVERSAL_PAGE_BATCH=10
MOLLIE_TEST_PROFILE_ID=
MOLLIE_TEST_API_KEY=
# Optional private Bearer-protected intake only; no public staging exception.
# CALLBACK_INTAKE_PROFILE_ID=pfl_replace_with_dedicated_test_profile
# Separate edge process is disabled; public staging ingress is another opt-in.
CALLBACK_EDGE_ENABLED=false
# CALLBACK_EDGE_BIND=127.0.0.1:45672
# CALLBACK_EDGE_PROXY_IPS=replace_with_inspected_exact_proxy_IPs

# Optional: opt in to the internal guest API with an exact canonical HTTPS origin.
# Omit for the existing non-selling preview. Secure cookies require HTTPS.
# GUEST_ORIGIN=https://your-private-preview.example
