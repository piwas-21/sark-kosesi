FROM rust:1.99.1-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b
WORKDIR /source
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY migrations ./migrations
COPY tests/fixtures ./tests/fixtures
ENV CARGO_BUILD_JOBS=2
RUN cargo test --locked -p commerce-infrastructure --test seed_preview --no-run && \
    find target/debug/deps -maxdepth 1 -type f -name 'seed_preview-*' -executable -exec cp {} /usr/local/bin/preview-seed \; && \
    test -x /usr/local/bin/preview-seed
ENTRYPOINT ["/usr/local/bin/preview-seed", "--exact", "seed_owned_browser_database"]
